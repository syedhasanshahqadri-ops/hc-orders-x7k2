rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Customers can place new orders.
      allow create: if request.resource.data.status == 'New'
                    && request.resource.data.total is number;
      // The staff page reads orders and changes only the status field.
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
