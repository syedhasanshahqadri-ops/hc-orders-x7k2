rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these accounts count as staff. Create each staff user in
    // Firebase console > Authentication > Users BEFORE publishing these rules.
    function isStaff() {
      return request.auth != null
          && request.auth.token.email in ['syedhasanshahqadri@gmail.com'];
    }

    match /orders/{orderId} {
      // Customers (anyone, no login) can only CREATE a valid new order.
      allow create: if request.resource.data.status == 'New'
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.total < 1000000
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() < 100
                    && request.resource.data.customer.name is string
                    && request.resource.data.customer.phone is string
                    && request.resource.data.customer.address is string
                    && request.resource.data.payment.screenshot.size() < 900000
                    && request.resource.data.createdAt == request.time;

      // Only staff can read orders (names, phones and addresses stay private).
      allow get, list: if isStaff();

      // Staff can change the status field and nothing else. Nobody can delete.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['New', 'Confirmed', 'Shipped', 'Delivered', 'Cancelled'];
      allow delete: if false;
    }
  }
}
